# Backend Environment Variables
# Copy this to .env and fill in values — NEVER commit .env

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/aobnap_db

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret_32_chars_min
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_DIR=./src/uploads
MAX_FILE_SIZE_MB=10

# National ID Verification Provider
# In development, MOCK provider is used automatically
NATIONAL_ID_PROVIDER=MOCK
NATIONAL_ID_PROVIDER_URL=
NATIONAL_ID_PROVIDER_KEY=

# QR / Public URL
PUBLIC_BASE_URL=http://localhost:5000
