generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]

  @@map("roles")
}

model User {
  id                    Int                    @id @default(autoincrement())
  fullName              String
  email                 String                 @unique
  phoneNumber           String?                @unique
  nationalIdRef         String?
  passwordHash          String
  roleId                Int
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]
  applications          BusinessApplication[]  @relation("ApplicantApplications")
  permissionReviews     BusinessPermission[]   @relation("PermissionReviewer")
  issuedCertificates    Certificate[]          @relation("CertificateIssuer")
  identityVerifications IdentityVerification[]
  languageReviews       LanguageReview[]       @relation("LanguageReviewer")
  notifications         Notification[]
  reservedTermsCreated  ReservedTerm[]
  uploadedDocuments     UploadedDocument[]
  role                  Role                   @relation(fields: [roleId], references: [id])

  @@map("users")
}

model BusinessCategory {
  id           Int                   @id @default(autoincrement())
  name         String
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt
  applications BusinessApplication[]

  @@map("business_categories")
}

model BusinessApplication {
  id                     Int                    @id @default(autoincrement())
  applicationNumber      String                 @unique
  applicantId            Int
  proposedBusinessName   String
  normalizedBusinessName String
  businessCategoryId     Int
  businessDescription    String
  businessAddress        String
  status                 String
  turizmStatus           String?
  turizmComment          String?
  turizmReviewedAt       DateTime?
  commercialStatus       String?
  commercialComment      String?
  commercialReviewedAt   DateTime?
  finalDecision          String?
  finalDecisionReason    String?
  submittedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  applicant              User                   @relation("ApplicantApplications", fields: [applicantId], references: [id])
  businessCategory       BusinessCategory       @relation(fields: [businessCategoryId], references: [id])
  registryEntry          BusinessNameRegistry?
  permission             BusinessPermission?
  certificate            Certificate?
  identityVerifications  IdentityVerification[]
  languageReview         LanguageReview?
  notifications          Notification[]         @relation("ApplicationNotifications")
  documents              UploadedDocument[]

  @@index([normalizedBusinessName])
  @@index([status])
  @@index([applicantId])
  @@map("business_applications")
}

model BusinessPermission {
  id            Int                 @id @default(autoincrement())
  applicationId Int                 @unique
  documentId    Int?
  status        String
  reviewedById  Int?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   BusinessApplication @relation(fields: [applicationId], references: [id])
  document      UploadedDocument?   @relation("PermissionDocument", fields: [documentId], references: [id])
  reviewer      User?               @relation("PermissionReviewer", fields: [reviewedById], references: [id])

  @@map("business_permissions")
}

model LanguageReview {
  id            Int                 @id @default(autoincrement())
  applicationId Int                 @unique
  status        String
  reviewedById  Int?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   BusinessApplication @relation(fields: [applicationId], references: [id])
  reviewer      User?               @relation("LanguageReviewer", fields: [reviewedById], references: [id])

  @@map("language_reviews")
}

model BusinessNameRegistry {
  id                     Int                  @id @default(autoincrement())
  businessName           String
  normalizedBusinessName String
  source                 String
  applicationId          Int?                 @unique
  approvalId             Int?
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  application            BusinessApplication? @relation(fields: [applicationId], references: [id])

  @@index([normalizedBusinessName])
  @@map("business_name_registry")
}

model Certificate {
  id             Int                 @id @default(autoincrement())
  applicationId  Int                 @unique
  approvalNumber String              @unique
  issuedById     Int
  issuedAt       DateTime            @default(now())
  qrPayloadUrl   String
  isValid        Boolean             @default(true)
  createdAt      DateTime            @default(now())
  application    BusinessApplication @relation(fields: [applicationId], references: [id])
  issuedBy       User                @relation("CertificateIssuer", fields: [issuedById], references: [id])

  @@map("certificates")
}

model Notification {
  id              Int                  @id @default(autoincrement())
  recipientId     Int
  title           String
  message         String
  type            String
  relatedEntityId Int?
  applicationId   Int?
  isRead          Boolean              @default(false)
  createdAt       DateTime             @default(now())
  application     BusinessApplication? @relation("ApplicationNotifications", fields: [applicationId], references: [id])
  recipient       User                 @relation(fields: [recipientId], references: [id])

  @@index([recipientId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorUserId   Int?
  action        String
  entityType    String
  entityId      Int?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ReservedTerm {
  id             Int      @id @default(autoincrement())
  term           String
  normalizedTerm String   @unique
  createdById    Int
  createdAt      DateTime @default(now())
  createdBy      User     @relation(fields: [createdById], references: [id])

  @@map("reserved_terms")
}

model UploadedDocument {
  id                 Int                  @id @default(autoincrement())
  applicationId      Int
  documentType       String
  originalFilename   String
  storedFilename     String
  mimeType           String
  fileSize           Int
  storagePath        String
  uploadedById       Int
  createdAt          DateTime             @default(now())
  permissionDocument BusinessPermission[] @relation("PermissionDocument")
  application        BusinessApplication  @relation(fields: [applicationId], references: [id])
  uploadedBy         User                 @relation(fields: [uploadedById], references: [id])

  @@index([applicationId])
  @@map("uploaded_documents")
}

model IdentityVerification {
  id            Int                  @id @default(autoincrement())
  userId        Int
  applicationId Int?
  provider      String
  status        String
  verifiedAt    DateTime?
  referenceId   String?
  createdAt     DateTime             @default(now())
  application   BusinessApplication? @relation(fields: [applicationId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("identity_verifications")
}

model CommunicationMessage {
  id                Int      @id @default(autoincrement())
  subject           String
  senderName        String
  senderDepartment  String
  recipientId       Int?
  applicationNumber String?
  body              String
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([recipientId])
  @@map("communication_messages")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
